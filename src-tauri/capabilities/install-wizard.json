{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "install-wizard",
  "description": "Permissions for the isolated install wizard",
  "windows": ["install-wizard"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://skills.sh/*"
        }
      ]
    },
    "install-wizard-commands"
  ]
}
